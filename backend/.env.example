# ── Local demo (default, offline) ────────────────────────────────────────
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/hackstack

# ── Supabase (verified working) ──────────────────────────────────────────
# Direct host db.<ref>.supabase.co:5432 is IPv6-only; use the Singapore pooler
# (IPv4). The password is set in the dashboard and must not be committed.
DATABASE_URL=postgresql://postgres.bzguwmwapgodhayhwsfr:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Empty => dev mode (trusts X-Dev-User). Set the legacy JWT secret only if the
# project still signs tokens with HS256; this project uses asymmetric keys, so
# verify against the JWKS below instead.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=https://bzguwmwapgodhayhwsfr.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_URL=https://bzguwmwapgodhayhwsfr.supabase.co

PORT=8080
CORS_ORIGIN=http://localhost:5173

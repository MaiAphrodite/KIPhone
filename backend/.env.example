# Supabase Postgres. Use the direct connection (5432) for migrations and the
# transaction pooler (6543) for the app; simple protocol is already enabled.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# Legacy JWT secret from Supabase > Settings > API. Leave empty for local dev.
SUPABASE_JWT_SECRET=
PORT=8080
CORS_ORIGIN=http://localhost:5173
